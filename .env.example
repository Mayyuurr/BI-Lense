# Application Environment
APP_NAME="BI-Lense SME Decision Intelligence"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS Configuration
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Database Configuration
POSTGRES_USER=bilense_user
POSTGRES_PASSWORD=bilense_password
POSTGRES_DB=bilense_db
DATABASE_URL=postgresql://bilense_user:bilense_password@localhost:5432/bilense_db

# Local LLaMA Service Configuration
LLAMA_ENABLED=false
LLAMA_BASE_URL=http://localhost:11434
LLAMA_MODEL_NAME=llama3:8b
LLAMA_TIMEOUT_SECONDS=30.0

# Storage Paths
MODEL_ARTIFACTS_DIR=./models/artifacts
DATASET_STORAGE_DIR=./data/storage

# Logging Configuration
LOG_LEVEL=INFO
